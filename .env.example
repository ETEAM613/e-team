# Variables d'environnement du site e-team (copier en .env.local pour les tests,
# ou les saisir dans hPanel > Node.js > Environment Variables pour le site en ligne).

# Base de données MySQL : mysql://UTILISATEUR:MOT_DE_PASSE@HOTE:3306/NOM_BASE
DATABASE_URL=

# Adresse publique du site (liens dans les e-mails)
SITE_URL=https://e-team.fr

# E-mails qui ont les droits administrateur (séparés par des virgules)
ADMIN_EMAILS=

# Envoi d'e-mails (boîte e-mail Hostinger du domaine)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=e-team <contact@e-team.fr>
